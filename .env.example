# ===== Server =====
NODE_ENV=development
PORT=3000
# SQLite 兜底（默认）；切 PostgreSQL 时改 prisma/schema.prisma provider 并配置 DATABASE_URL
DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me-in-production
JWT_ACCESS_TTL_SEC=7200
JWT_REFRESH_TTL_SEC=2592000

# ===== WeChat =====
# mock 登录开关：仅 NODE_ENV!=production 时允许
WECHAT_MOCK=true
WECHAT_APPID=
WECHAT_SECRET=

# ===== MQTT =====
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_WS_PORT=8888

# ===== Virtual BLE =====
VIRTUAL_BLE_PORT=7001

# ===== Admin =====
VITE_API_BASE=http://127.0.0.1:3000

# ===== Miniapp =====
# base URL for H5/dev; 真机用局域网 IP
VITE_API_BASE=http://127.0.0.1:3000
VITE_USE_VIRTUAL_BLE=true
